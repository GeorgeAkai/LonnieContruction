# Password Lonnie uses to sign in at /admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (any long random string)
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Vercel Blob read/write token. Vercel adds this automatically when you
# connect a Blob store to the project (Storage tab -> Create -> Blob).
# Without it, photos and project data are saved to the local filesystem
# (fine for local development, NOT persistent on Vercel).
BLOB_READ_WRITE_TOKEN=
